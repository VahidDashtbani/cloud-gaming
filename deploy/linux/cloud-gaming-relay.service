[Unit]
Description=Cloud Gaming Linux Relay & Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cloud-gaming
ExecStart=/opt/cloud-gaming/linux-relay -addr :8080 -public-host 127.0.0.1:8080 -token-file /opt/cloud-gaming/pairing_secret.key
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
